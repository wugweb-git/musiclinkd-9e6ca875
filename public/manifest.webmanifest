{
  "name": "MusicLinkd",
  "short_name": "MusicLinkd",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ECECF1",
  "theme_color": "#ECECF1",
  "icons": [
    {
      "src": "/favicon.svg",
      "type": "image/svg+xml",
