{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "css": "src/styles.css",
    "baseColor": "slate",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "registries": {
    "@aceternity": "https://ui.aceternity.com/registry/{name}.json",
    "@agents-ui": "https://livekit.com/ui/r/{name}.json",
    "@animate-ui": "https://animate-ui.com/r/{name}.json",
    "@animbits": "https://animbits.dev/r/{name}.json",
    "@waves-cn": "https://waves-cn.vercel.app/r/{name}.json",
    "@limeplay": "https://limeplay.winoffrg.dev/r/{name}.json",
    "@liquefy-ui": "https://liquefy-ui.com/r/{name}.json",
    "@glasscn": "https://glasscn-components.vercel.app/r/{name}.json",
    "@materialcn": "https://guillermo-rebolledo.github.io/materialcn/r/{name}.json",
    "@kibo-ui": "https://www.kibo-ui.com/r/{name}.json"
  }
}
