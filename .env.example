# Every environment variable the app reads, with no values. Copy to `.env` and fill in.
#
# VITE_* are compiled into the browser bundle and are public by definition — never put a secret
# behind a VITE_ name. Everything else is server-side only and must never gain a VITE_ prefix.

# --- Database and auth (required; the app will not start without these) -----------------------
# From the Lovable Cloud / Supabase project. The publishable key is the anon key and is public.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# The same three for server functions.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Bypasses row-level security. Server only, never logged, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Spotify (optional) ------------------------------------------------------------------------
# Linking a Spotify account from Settings. Without these the Spotify row reports it is unavailable.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# --- Google Places (optional) --------------------------------------------------------------------
# Resolving a business's Google Maps link into an address when creating a business page.
GOOGLE_PLACES_API_KEY=

# --- Scheduled jobs (optional) -------------------------------------------------------------------
# Shared secret a cron caller presents. _PREVIOUS lets a rotation overlap so in-flight jobs survive.
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=

# --- Analytics (optional) ------------------------------------------------------------------------
# A GA4 measurement id ("G-XXXXXXXXXX"). Leave empty and no analytics code loads at all and the
# consent row stays hidden. Even with an id set, nothing reports until someone switches it on in
# Settings → Privacy. Note the Cookie Policy page (cms_pages, slug legal-cookies) is currently
# empty — worth writing before this is switched on for real people.
VITE_GA_MEASUREMENT_ID=
